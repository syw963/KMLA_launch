<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MealWidget" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/widget_accent</item>
        <item name="android:colorPrimary">@color/widget_accent</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 위젯 -->
    <style name="WidgetTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
    </style>

    <style name="WidgetMenuText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">top|start</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>

    <!-- 앱 화면 -->
    <style name="MealCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="MealCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/widget_accent</item>
    </style>

    <style name="MealCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
    </style>
</resources>
