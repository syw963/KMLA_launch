<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- 날짜 + 새로고침 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/icon_button_bg"
            android:contentDescription="@string/refresh"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/widget_text_secondary" />
    </LinearLayout>

    <!-- 아침 / 점심 / 저녁 세그먼트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/tab_track_bg"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_breakfast"
            style="@style/WidgetTab"
            android:text="@string/breakfast" />

        <TextView
            android:id="@+id/tab_lunch"
            style="@style/WidgetTab"
            android:text="@string/lunch" />

        <TextView
            android:id="@+id/tab_dinner"
            style="@style/WidgetTab"
            android:text="@string/dinner" />
    </LinearLayout>

    <!-- 메뉴 (공간이 넉넉하면 1칸, 메뉴가 많으면 2칸) -->
    <LinearLayout
        android:id="@+id/widget_menu_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_menu"
            style="@style/WidgetMenuText"
            android:text="@string/loading" />

        <TextView
            android:id="@+id/widget_menu_2"
            style="@style/WidgetMenuText"
            android:layout_marginStart="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="11sp" />
</LinearLayout>
